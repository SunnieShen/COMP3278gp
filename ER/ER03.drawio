        <mxCell id="shipping_fee_note" value="shipping_fee is stored on DELIVERY (not on HAS_DELIVERY): HAS_DELIVERY is 1:1 with total participation on DELIVERY, so the attribute migrates to the entity with no NULLs on ORDERS. Self-Pickup orders have no DELIVERY and hence no fee. If the fee is computed from distance/weight, draw it as a dashed (derived) oval instead." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" parent="1" vertex="1">
          <mxGeometry x="1700" y="680" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="group_status_note" value="group_status is derived from deadline: open while NOW() &lt; deadline, else locked (dashed oval = derived attribute). &#39;completed&#39; is dropped because it duplicates ORDERS.order_status. Early locking is not supported." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="1400" width="260" height="100" as="geometry" />
        </mxCell>
