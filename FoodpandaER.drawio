<mxfile host="app.diagrams.net">
  <diagram name="ERD">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600"
      pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- USERS -->
        <mxCell id="users"
          value="USERS&#10;──────────────&#10;PK id&#10;name&#10;email (UK)&#10;password_hash&#10;created_at"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="220" height="180" as="geometry"/>
        </mxCell>

        <!-- RESTAURANTS -->
        <mxCell id="restaurants"
          value="RESTAURANTS&#10;──────────────&#10;PK id&#10;FK owner_id&#10;name&#10;store_type&#10;cuisine&#10;rating&#10;delivery_fee"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="250" height="220" as="geometry"/>
        </mxCell>

        <!-- MENU ITEMS -->
        <mxCell id="menu_items"
          value="MENU_ITEMS&#10;──────────────&#10;PK id&#10;FK restaurant_id&#10;name&#10;price&#10;is_available"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="230" height="180" as="geometry"/>
        </mxCell>

        <!-- GROUP ORDERS -->
        <mxCell id="group_orders"
          value="GROUP_ORDERS&#10;──────────────&#10;PK id&#10;FK host_id&#10;FK restaurant_id&#10;status&#10;deadline&#10;created_at"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="380" y="350" width="250" height="210" as="geometry"/>
        </mxCell>

        <!-- ORDER MEMBERS -->
        <mxCell id="order_members"
          value="ORDER_MEMBERS&#10;──────────────&#10;PK/FK group_order_id&#10;PK/FK user_id&#10;joined_at"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="250" height="160" as="geometry"/>
        </mxCell>

        <!-- ORDER ITEMS -->
        <mxCell id="order_items"
          value="ORDER_ITEMS&#10;──────────────&#10;PK id&#10;FK group_order_id&#10;FK user_id&#10;FK menu_item_id&#10;quantity&#10;unit_price (snapshot)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;"
          vertex="1" parent="1">
          <mxGeometry x="760" y="340" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- Relationships -->

        <mxCell id="r1"
          value="owns 1:N"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="users" target="restaurants">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r2"
          value="has 1:N"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="restaurants" target="menu_items">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r3"
          value="hosts 1:N"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="users" target="group_orders">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r4"
          value="restaurant 1:N"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="restaurants" target="group_orders">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r5"
          value="contains 1:N"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="group_orders" target="order_items">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r6"
          value="orders 1:N"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="users" target="order_items">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r7"
          value="menu item 1:N"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="menu_items" target="order_items">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r8"
          value="M:N join"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="users" target="order_members">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r9"
          value="M:N join"
          style="endArrow=block;html=1;"
          edge="1" parent="1" source="group_orders" target="order_members">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
